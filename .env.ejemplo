# Opcional: solo si quieres clips de movimiento REAL (no es gratis ilimitado).
# El movimiento cinematográfico (por defecto) no necesita nada de esto.
# Copia este archivo como ".env" y llena solo lo que vayas a usar.
# NUNCA subas tu .env a GitHub.

# fal.ai — clips reales, se paga por segundo (https://fal.ai)
FAL_API_KEY=
# Modelo de fal.ai (image-to-video). El de MiniMax es de los más baratos.
FAL_MODEL=fal-ai/minimax/hailuo-07/image-to-video

# Magic Hour — API con créditos gratis al registrarse (https://magichour.ai/developer)
MAGIC_HOUR_API_KEY=

# FreeLLMAPI — tu propio servidor (https://github.com/tashfeenahmed/freellmapi)
FREELLMAPI_URL=http://localhost:3001
FREELLMAPI_KEY=
